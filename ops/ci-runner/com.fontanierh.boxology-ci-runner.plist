<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fontanierh.boxology-ci-runner</string>
  <key>ProgramArguments</key>
  <array><string>/ABSOLUTE/PATH/TO/REVIEWED-INSTALLED-SUPERVISE.SH</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>REPOSITORY</key><string>OWNER/REPOSITORY</string>
    <key>CI_RUNNER_IMAGE</key><string>VERIFIED-IMAGE:TAG</string>
    <key>DOCKER_CONTEXT</key><string>colima-boxology-ci-arm64</string>
    <key>KEYCHAIN_SERVICE</key><string>com.fontanierh.boxology-ci-runner</string>
    <key>MAX_RUNNERS</key><string>4</string>
    <key>PATH</key><string>/ABSOLUTE/PATH/TO/REQUIRED/BINARIES:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/TO/SANITIZED-LOG</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/TO/SANITIZED-ERROR-LOG</string>
</dict>
</plist>
